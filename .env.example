# =============================================================================
# ZWIFT CREDENTIALS
# =============================================================================
# The email and password you use for the Zwift companion app. They are sent
# over TLS to Zwift's own OAuth server (secure.zwift.com) as a password grant;
# the resulting tokens are cached in .zwift_token.json (mode 600).

ZWIFT_USER=your_email@example.com
ZWIFT_PASS=your_zwift_password

# Optional. Set only if you know your numeric Zwift athlete id and want to
# skip the profile lookup.
# ZWIFT_ATHLETE_ID=

# =============================================================================
# ZWIFTPOWER
# =============================================================================
# ZwiftPower signs in through Zwift SSO, so the credentials above are used by
# default. Set these only if your ZwiftPower account differs.
#
# The account must have been linked to ZwiftPower once in a browser before
# any of its endpoints return data.

# ZWIFTPOWER_USER=
# ZWIFTPOWER_PASS=

# =============================================================================
# SYNC SETTINGS
# =============================================================================

# Path to the SQLite database the downloader writes and the server reads.
ZWIFT_DB_PATH=./zwift_activities.db

# Where original FIT files are cached. They are the only source of per-second
# data, so keeping them means a re-parse never re-downloads.
ZWIFT_FIT_CACHE=./fits

# Earliest date to sync on a first run (YYYY-MM-DD).
# Defaults to 2 years back. --since and --days override this.
ZWIFT_START_DATE=2020-01-01

# Every derived metric (IF, TSS, CTL, ATL, TSB, power zones) is scaled
# against FTP. Each ride prefers the FTP Zwift held at the time; where that
# is unknown these apply. Set the override if the in-game value is stale.
# ZWIFT_FTP_OVERRIDE=250

# Threshold power for runs. Zwift's running power is not the same quantity
# as a bike FTP, so without this runs are scored against the cycling FTP and
# their TSS is indicative only.
# ZWIFT_RUN_FTP=

# =============================================================================
# MCP SERVER HTTP TRANSPORT
# =============================================================================

# "http" for remote MCP clients, "stdio" for local Claude Desktop.
# Defaults to "http" when unset.
ZWIFT_MCP_TRANSPORT=http

# Required when ZWIFT_MCP_TRANSPORT=http. Protects BOTH the MCP endpoint
# and the REST API.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ZWIFT_MCP_AUTH_TOKEN=

# HTTP bind address and port. 8081 by default so this can run alongside
# coros-mcp, which uses 8080.
ZWIFT_MCP_HTTP_HOST=0.0.0.0
ZWIFT_MCP_HTTP_PORT=8081
